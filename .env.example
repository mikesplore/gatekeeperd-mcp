# ─── Gatekeeperd backend ─────────────────────────────────────────────────────
# Base URL of the deployed Gatekeeperd API (no trailing slash)
GATEKEEPERD_URL=http://localhost:8080/api

# Admin credentials — the server logs in at startup to obtain a fresh JWT.
# These are preferred over GATEKEEPERD_TOKEN since JWTs expire every 24h.
GATEKEEPERD_ADMIN_EMAIL=admin@example.com
GATEKEEPERD_ADMIN_PASSWORD=

# Pre-seeded JWT token (optional, takes precedence over credentials above).
# Only useful if you want to supply a token directly and manage rotation yourself.
GATEKEEPERD_TOKEN=

# ─── MCP server auth — legacy SSE transport (MCP_TRANSPORT=http) ─────────────
# When MCP_API_KEY is set, every inbound request must carry:
#   Authorization: Bearer <MCP_API_KEY>
# Required when MCP_TRANSPORT=http — the server will refuse to start without it.
MCP_API_KEY=

# Set to 'true' to allow HTTP transport without an API key.
# NOT recommended — exposes all admin tools to the network with no auth.
ALLOW_UNAUTHENTICATED_HTTP=false

# ─── OAuth 2.0 — streamable-http transport (MCP_TRANSPORT=streamable-http) ───
# Required: public HTTPS URL of this server (no trailing slash).
# This is the OAuth issuer and the base URL Claude.ai uses to reach the server.
# Example: https://mcp.example.com
MCP_OAUTH_ISSUER=

# Pre-registered client ID for Claude.ai (default: claude).
# Claude will use this client_id when starting the OAuth flow.
MCP_OAUTH_CLIENT_ID=claude

# Optional client secret (leave blank to rely on PKCE-only validation).
MCP_OAUTH_CLIENT_SECRET=

# Access token lifetime in seconds (default: 3600 = 1 hour).
MCP_OAUTH_TOKEN_TTL=3600

# ─── Transport ───────────────────────────────────────────────────────────────
# stdio           → Bob spawns the process directly (default, no network needed)
# http            → Legacy SSE endpoint for older clients (Bob, MCP Inspector)
# streamable-http → Modern Streamable HTTP + OAuth 2.0 for Claude.ai web
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http or MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=9000
